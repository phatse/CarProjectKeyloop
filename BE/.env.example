# Copy to `.env` (which is gitignored) and adjust as needed.

NODE_ENV=development
PORT=3000

# Local Postgres from docker-compose.yml at the repository root.
DATABASE_URL=postgresql://carproject:carproject@localhost:5432/carproject?schema=public

# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Mock upstream systems (npm run mock:sales / mock:service).
SALES_API_URL=http://localhost:4001
SERVICE_API_URL=http://localhost:4002
# Deadline per upstream call in milliseconds.
UPSTREAM_TIMEOUT_MS=1500
