// Connection URL lives in prisma7.config.ts, not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// One row per document search. Documents themselves are owned by the upstream
/// systems and are never copied here (ADR-0003).
model SearchAudit {
  id               String   @id @default(uuid()) @db.Uuid
  correlationId    String   @map("correlation_id") @db.VarChar(128)
  vin              String   @db.VarChar(17)
  salesStatus      String   @map("sales_status") @db.VarChar(20)
  serviceStatus    String   @map("service_status") @db.VarChar(20)
  salesLatencyMs   Int      @map("sales_latency_ms")
  serviceLatencyMs Int      @map("service_latency_ms")
  documentCount    Int      @map("document_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([vin, createdAt(sort: Desc)], map: "idx_search_audit_vin_created")
  @@index([correlationId], map: "idx_search_audit_correlation")
  @@map("search_audit")
}
